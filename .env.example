# ExitZero — configuration
# Copy to .env in your project folder or in the exitzero folder.

# ── Backend ────────────────────────────────────────────────────────────────
# "openrouter" (recommended — free, fast, accurate)
# "ollama"     (local, no API key needed)
EXITZERO_LLM_BACKEND=openrouter

# ── OpenRouter (get free key at openrouter.ai) ─────────────────────────────
OPENROUTER_API_KEY=your_key_here

# Free models on OpenRouter (no payment required):
EXITZERO_PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct:free
EXITZERO_BACKUP_MODEL=google/gemma-2-9b-it:free

# ── Ollama (if using local backend) ────────────────────────────────────────
# EXITZERO_LLM_BACKEND=ollama
# EXITZERO_PRIMARY_MODEL=qwen2.5-coder:7b
# EXITZERO_BACKUP_MODEL=qwen2.5-coder:3b

# ── General ────────────────────────────────────────────────────────────────
EXITZERO_LLM_TIMEOUT=60
